# EventWatch AI - Environment Configuration

# Application
APP_NAME=EventWatch AI
APP_VERSION=2.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eventwatch
DATABASE_ECHO=False

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=False

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Webhook
WEBHOOK_URL=http://localhost:9000/webhook
WEBHOOK_TIMEOUT=10

# Anomaly Detection
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_THRESHOLD=0.7

# Alert Settings
ALERT_BATCH_SIZE=100
ALERT_RETENTION_DAYS=30
